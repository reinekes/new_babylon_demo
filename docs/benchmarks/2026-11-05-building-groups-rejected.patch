+// Presentation only. Call update after replacing geometry or recomputing frozen
+// world matrices; owners retain the original instances for highlights/fallback.
+export function createBuildingRenderGroups(B,scene,meshes,{regionSize=8,strategy='merge'}={}){
+ const groups=new Map(),originals=new Map();let disposed=false;
+ const restore=()=>{for(const [mesh,enabled]of originals)if(!mesh.isDisposed())mesh.setEnabled(enabled);};
+ const release=group=>{const i=meshes.indexOf(group.mesh);if(i>=0)meshes.splice(i,1);group.mesh.dispose(false,false);};
+ function eligible(entry){
+  const m=entry.mesh,s=m.sourceMesh||m;
+  if(entry.working||m.metadata?.homeLamp||!m.isEnabled()||!m.isVisible||m.visibility!==1||!m.isPickable||!m.material||s.skeleton||s.morphTargetManager||s.billboardMode||s.thinInstanceCount||s.animations?.length||m.animations?.length||s.material?.subMaterials||m.material.needAlphaBlendingForMesh?.(m)||m.material.needAlphaTestingForMesh?.(m)||m.material.alpha!==1)return false;
+  const w=m.getWorldMatrix(),a=w.m,scale=[Math.hypot(a[0],a[1],a[2]),Math.hypot(a[4],a[5],a[6]),Math.hypot(a[8],a[9],a[10])];
+  // Reflections need winding changes; nonuniform/sheared transforms need normal
+  // inverse-transposes. Leave both on Babylon's original instance path.
+  return w.determinant()>0&&scale[0]>0&&scale.every(v=>Math.abs(v-scale[0])<1e-5)&&Math.abs(a[0]*a[4]+a[1]*a[5]+a[2]*a[6])<1e-5&&Math.abs(a[0]*a[8]+a[1]*a[9]+a[2]*a[10])<1e-5&&Math.abs(a[4]*a[8]+a[5]*a[9]+a[6]*a[10])<1e-5;
+ }
+ function update(entries){
+  if(disposed)return;restore();const wanted=new Map(),seen=new Set();
+  for(const entry of entries){
+   const m=entry.mesh;if(!m||m.isDisposed()||seen.has(m))continue;seen.add(m);
+   if(!originals.has(m))originals.set(m,m.isEnabled());if(!eligible(entry))continue;
+   const s=m.sourceMesh||m,key=[strategy==='thin'?'thin':Math.floor(entry.x/regionSize),strategy==='thin'?s.geometry?.uniqueId:Math.floor(entry.y/regionSize),m.material.uniqueId,m.layerMask,m.renderingGroupId,m.receiveShadows,s.overrideMaterialSideOrientation,s.hasVertexAlpha,s.useVertexColors,s.getVerticesDataKinds().sort().join(',')].join(':');
+   if(!wanted.has(key))wanted.set(key,[]);wanted.get(key).push(entry);
+  }
+  for(const m of originals.keys())if(!seen.has(m)||m.isDisposed())originals.delete(m);
+  const retained=new Set();
+  for(const [key,parts]of wanted){
+   if(parts.length<2)continue;const signature=parts.map(({mesh:m})=>[m.uniqueId,m.getWorldMatrix().updateFlag,(m.sourceMesh||m).geometry?.uniqueId].join(',')).join('|');let group=groups.get(key);
+   if(group?.signature!==signature){
+    if(group){release(group);groups.delete(key);}let merged=null;const proxies=[];
+    try{
+     // MergeMeshes rejects InstancedMesh. Disposable regular meshes share each
+     // source Geometry, bake its instance's exact world matrix, then relinquish
+     // only their own references. No source/material/texture is disposed.
+     if(strategy==='thin'){
+      const source=parts[0].mesh.sourceMesh||parts[0].mesh;merged=source.clone('building-thin-group',null,true);merged.parent=null;merged.makeGeometryUnique();merged.freezeWorldMatrix(B.Matrix.Identity());const matrix=new Float32Array(parts.length*16);parts.forEach(({mesh},i)=>mesh.getWorldMatrix().copyToArray(matrix,i*16));merged.thinInstanceSetBuffer('matrix',matrix,16,true);merged.thinInstanceEnablePicking=true;merged.thinInstanceRefreshBoundingInfo(true);
+     }else{
+     for(const {mesh:m}of parts){const p=(m.sourceMesh||m).clone('building-merge-proxy',null,true);proxies.push(p);p.parent=null;p.material=m.material;p.freezeWorldMatrix(m.getWorldMatrix().clone());}
+     merged=B.Mesh.MergeMeshes(proxies,false,true,null,false,false);
+     }
+    }catch{if(merged){merged.dispose(false,false);merged=null;}}finally{for(const p of proxies)p.dispose(false,false);}
+    if(!merged)continue;
+    const first=parts[0].mesh,s=first.sourceMesh||first;merged.name=`building-region-${key}`;merged.material=first.material;merged.isVisible=true;merged.isPickable=true;merged.checkCollisions=false;merged.receiveShadows=first.receiveShadows;merged.layerMask=first.layerMask;merged.renderingGroupId=first.renderingGroupId;merged.overrideMaterialSideOrientation=s.overrideMaterialSideOrientation;merged.hasVertexAlpha=s.hasVertexAlpha;merged.useVertexColors=s.useVertexColors;
+    let end=0;const faces=parts.map(({mesh:m})=>({end:end+=m.getTotalIndices()/3,entity:m.metadata}));merged.metadata={buildingRenderGroup:strategy==='thin'?{entities:parts.map(({mesh})=>mesh.metadata)}:{faces}};merged.computeWorldMatrix(true);merged.freezeWorldMatrix();group={mesh:merged,signature};groups.set(key,group);meshes.push(merged);
+   }
+   retained.add(key);for(const {mesh}of parts)mesh.setEnabled(false);
+  }
+  for(const [key,group]of groups)if(!retained.has(key)){release(group);groups.delete(key);}
+ }
+ function dispose(){if(disposed)return;disposed=true;restore();for(const group of groups.values())release(group);groups.clear();originals.clear();}
+ return {update,dispose};
+}
+
+// Babylon reports a global triangle faceId for the merged single submesh.
+export function buildingGroupEntity(group,faceId,thinInstanceIndex){
+ if(faceId===undefined)return group;
+ if(group.entities)return Number.isInteger(thinInstanceIndex)&&thinInstanceIndex>=0&&thinInstanceIndex<group.entities.length?group.entities[thinInstanceIndex]:null;
+ const faces=group.faces;if(!Number.isInteger(faceId)||faceId<0||faceId>=faces.at(-1)?.end)return null;
+ let lo=0,hi=faces.length-1;while(lo<hi){const mid=(lo+hi)>>1;if(faceId<faces[mid].end)hi=mid;else lo=mid+1;}return faces[lo].entity;
+}
